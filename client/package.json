{
  "name": "uran",
  "version": "1.0.0",
  "description": "URAN Application",
  "author": "Your Name",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "make": "electron-builder --dir",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.uran.app",
    "productName": "uran",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/.cache",
      "!**/.git",
      "!**/.github",
      "!**/dist"
    ],
    "asar": false,
    "win": {
      "target": "dir",
      "executableName": "uran.exe"
    },
    "linux": {
      "target": "dir",
      "executableName": "uran"
    },
    "mac": {
      "target": "dir",
      "executableName": "uran"
    }
  }
}
